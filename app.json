{
  "expo": {
    "name": "PetCareCompanion",
    "slug": "petcarecompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "petcarecompanion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petcarecompanion.app"
    },
    "android": {
      "package": "com.petcarecompanion.app",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4EDE3"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "care-reminders",
          "color": "#E85D3F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PetCareCompanion to select photos for pet profiles.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "277b7a1f-dc5c-49f5-ba7f-05b94b204bea"
      }
    }
  }
}
